      object gbxBios: TGroupBox
        AlignWithMargins = True
        Left = 5
        Top = 20
        Width = 529
        Height = 90
        Align = alTop
        Caption = 'Bios'
        TabOrder = 0
        object lblBiosScanResult: TLabel
          Left = 91
          Top = 57
          Width = 130
          Height = 15
          Caption = 'No scan performed yet...'
