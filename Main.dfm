object frmMain: TfrmMain
  Left = 0
  Top = 0
  BorderIcons = [biSystemMenu, biMinimize]
  BorderStyle = bsSingle
  Caption = 'Retrofix - Fix your game collection'
  ClientHeight = 461
  ClientWidth = 545
  Color = clBtnFace
  Font.Charset = DEFAULT_CHARSET
  Font.Color = clWindowText
  Font.Height = -12
  Font.Name = 'Segoe UI'
  Font.Style = []
  Position = poScreenCenter
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  OnShow = FormShow
  TextHeight = 15
  object pnlMain: TPanel
    Left = 0
    Top = 53
    Width = 545
    Height = 378
    Align = alClient
    BevelOuter = bvNone
    TabOrder = 0
    object gbxActions: TGroupBox
      AlignWithMargins = True
      Left = 3
      Top = 3
      Width = 539
      Height = 372
      Align = alClient
      Caption = 'Actions'
      Enabled = False
      TabOrder = 0
      object gbxBios: TGroupBox
        AlignWithMargins = True
        Left = 5
        Top = 20
        Width = 529
        Height = 90
        Align = alTop
        Caption = 'Bios'
        TabOrder = 0
        object lblBiosScanResult: TLabel
          Left = 91
          Top = 57
          Width = 130
          Height = 15
          Caption = 'No scan performed yet...'
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clGray
          Font.Height = -12
          Font.Name = 'Segoe UI'
          Font.Style = []
          ParentFont = False
          StyleElements = [seClient, seBorder]
        end
        object btnScanBios: TButton
          Left = 10
          Top = 22
          Width = 278
          Height = 25
          Caption = 'Scan BIOS'
          TabOrder = 0
          OnClick = btnScanBiosClick
        end
        object chkForceExtract: TCheckBox
          Left = 294
          Top = 26
          Width = 109
          Height = 17
          Hint = 
            'Force Bios list extraction from batocera-systems.exe'#13#10'if bios.js' +
            'on already exists (useful when Retrobat has been updated)'
          Caption = 'Force extraction'
          ParentShowHint = False
          ShowHint = True
          TabOrder = 1
          OnClick = chkForceExtractClick
        end
        object chkStrictMode: TCheckBox
          Left = 409
          Top = 26
          Width = 109
          Height = 17
          Hint = 
            'Apply only on BIOS with MD5'#13#10'If checked, will be considered miss' +
            'ing if MD5 mismatch'#13#10'Else will just display a mismatch warning'
          Caption = 'Strict mode'
          ParentShowHint = False
          ShowHint = True
          TabOrder = 2
          OnClick = chkStrictModeClick
        end
        object btnBiosScanDetails: TButton
          Left = 10
          Top = 53
          Width = 75
          Height = 25
          Caption = 'Details...'
          Enabled = False
          TabOrder = 3
          OnClick = btnBiosScanDetailsClick
        end
      end
      object gbxGamelists: TGroupBox
        AlignWithMargins = True
        Left = 5
        Top = 116
        Width = 529
        Height = 90
        Align = alTop
        Caption = 'Gamelists'
        TabOrder = 1
        object lblGamelistScanResult: TLabel
          Left = 91
          Top = 52
          Width = 422
          Height = 31
          AutoSize = False
          Caption = 'No scan performed yet...'
          Font.Charset = DEFAULT_CHARSET
          Font.Color = clGray
          Font.Height = -12
          Font.Name = 'Segoe UI'
          Font.Style = []
          ParentFont = False
          Layout = tlCenter
          WordWrap = True
          StyleElements = [seClient, seBorder]
        end
        object btnScanGamelists: TButton
          Left = 10
          Top = 24
          Width = 278
          Height = 25
          Caption = 'Scan Gamelists'
          TabOrder = 0
          OnClick = btnScanGamelistsClick
        end
        object btnGamelistScanDetails: TButton
          Left = 10
          Top = 55
          Width = 75
          Height = 25
          Caption = 'Details...'
          Enabled = False
          TabOrder = 1
          OnClick = btnGamelistScanDetailsClick
        end
      end
    end
  end
  object pnlTop: TPanel
    Left = 0
    Top = 0
    Width = 545
    Height = 53
    Align = alTop
    BevelOuter = bvNone
    TabOrder = 1
