      ImageAlignment = iaCenter
      ImageIndex = 0
      Images = imageList
      ParentShowHint = False
      ShowHint = True
      TabOrder = 2
      OnClick = btnSaveSettingsClick
    end
  end
  object pnlBottom: TPanel
    Left = 0
    Top = 431
    Width = 545
    Height = 30
    Margins.Top = 0
