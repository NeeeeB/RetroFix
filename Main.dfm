    object btnSelectFolder: TButton
      Left = 303
      Top = 26
      Width = 66
      Height = 25
      Caption = 'Select'
      Default = True
      TabOrder = 1
      OnClick = btnSelectFolderClick
    end
    object btnSaveSettings: TButton
      Left = 375
      Top = 26
      Width = 25
      Height = 25
